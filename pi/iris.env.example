# Copy to /etc/iris/iris.env on the Raspberry Pi and replace the token.
IRIS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
IRIS_BIND_HOST=0.0.0.0
IRIS_PI_PORT=8766
IRIS_ALLOWED_PC_IP=192.168.1.213

# Keep every hardware/motion gate OFF during setup.
IRIS_ENABLE_HARDWARE=0
IRIS_CALIBRATION_MODE=0
IRIS_ALLOW_COORDINATED_MOTION=0
