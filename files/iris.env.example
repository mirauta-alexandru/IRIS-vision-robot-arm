# Load these variables before starting files/iris_bridge.py on the Dell.
IRIS_TRANSPORT=pi
IRIS_PI_HOST=192.168.1.196
IRIS_PI_PORT=8766
IRIS_PC_IP=192.168.1.213
IRIS_TOKEN=REPLACE_WITH_THE_SAME_LONG_RANDOM_SECRET

# Keep optional movement features disabled until physical calibration is complete.
IRIS_ALLOW_PRESET_MOTIONS=0
IRIS_ALLOW_AUTONOMOUS_MOTION=0
